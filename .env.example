# Copy to .env and adjust. Used by manage.py, scripts/*.sh and systemd.
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

POSTGRES_DB=logpulse
POSTGRES_USER=logpulse
POSTGRES_PASSWORD=logpulse
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ETL tuning
LOGPULSE_BATCH_SIZE=1000
LOGPULSE_DEDUPE_WINDOW=100000
LOGPULSE_MAX_UPLOAD_MB=50

# Directories used by scripts/run_etl.sh and scripts/backup_db.sh
LOGPULSE_INCOMING_DIR=./incoming_logs
LOGPULSE_PROCESSED_DIR=./processed_logs
LOGPULSE_FAILED_DIR=./failed_logs
LOGPULSE_BACKUP_DIR=./backups
LOGPULSE_BACKUP_RETENTION_DAYS=7
